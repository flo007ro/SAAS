# Local disposable PostgreSQL. Replace privately; never commit real URLs.
# Vercel: provider pooled URL for runtime; direct URL for Prisma migration CLI.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/steel_saas?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/steel_saas?schema=public"

# Generate a unique random secret (at least 32 bytes) for each environment.
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Server-side only: paid (default) or free_beta for free testing access.
# Free beta disables checkout and customer portal; it does not cancel existing subscriptions.
BILLING_MODE="paid"

# Required for paid subscription checkout, customer portal, and webhook activation.
STRIPE_SECRET_KEY=""
STRIPE_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# Opt in only for disposable development data, NEVER production.
ALLOW_DEMO_SEED="false"
